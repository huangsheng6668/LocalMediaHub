# Copy this file to android/keystore.properties and fill in your release
# signing details. NEVER commit the real keystore.properties (it is gitignored).
#
# Generate a keystore once with:
#   keytool -genkeypair -v -keystore localmediahub.keystore -alias localmediahub \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Then reference it here:
storeFile=localmediahub.keystore
storePassword=your-store-password
keyAlias=localmediahub
keyPassword=your-key-password
