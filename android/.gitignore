# Rust cargo-ndk build artifacts.
# libffmpeg.so is already tracked by git (pre-built), so this rule does NOT
# affect it — .gitignore only applies to untracked files. The rule prevents
# the cargo-ndk output (liblocalmedia_native.so) from being committed.
